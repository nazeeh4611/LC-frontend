NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Presentation / demo mode — keep this "true" for investor demos so the
# entire catalogue, cart, checkout, demo payments (COD/Card/UPI/Net Banking)
# and order confirmation work end-to-end with NO backend and NO login
# required. Set to "false" once your real backend is live and seeded with
# data, and the site will call the real API (falling back to demo data
# automatically if that API is ever unreachable).
NEXT_PUBLIC_DEMO_MODE=true
